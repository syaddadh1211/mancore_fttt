_method rwwi_apd_tools_dialog.cek_fttt()

	start << date_time_now()
	write("Starting at :", date_time_now())
	
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		.owner.show_alert("Tidak ada design yang terbuka")
		_leave 
	_endif

	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	

	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	a_ff << float_format.new_with_properties(
		      :float_format,:fixed,
		      :float_decimal_places,10)	
	a_fc << float_format.new_with_properties(
		      :float_format,:fixed,
		      :float_decimal_places,1)
	
	change_set << mit_scheme_record_change_set.new(s)

	#looping dalam design ambil obyek yang nanti diperlukan untuk
	# looping selanjutnya
	#khusus sheath loc jadikan sector dulu agar bisa diambil first/last coordinatnya
	sheathlocs << rope.new()
	towers << rope.new()
	splices << rope.new()
	sheaths << rope.new()

	obj_tree << rope.new()
	
	_for i _over change_set.fast_elements()
	_loop
		_if i.current_record _isnt _unset 
		_then 
			name << i.current_record.source_collection.name
		_else
			_continue 
		_endif
		
		_if name = "sheath_with_loc"
		_then 
			sheathlocs.add(i.current_record)
		_elif name = "mit_tower"
		_then
			towers.add(i.current_record)
		_elif name = "sheath_splice"
		_then			
			splices.add(i.current_record)
		_elif name = "sheath"
		_then
			sheaths.add(i.current_record)
	
		_endif 
	_endloop	

	
	_try 
		towers_asc << towers.as_sorted_collection( :sort_by_program )
		urut1 << _unset 
		_for urut _over towers_asc.fast_elements()
		_loop
			urut1 << urut.folders.as_number()
			counter << 0
			_for next_urut _over towers_asc.fast_elements()
			_loop
				_if urut1 = next_urut.folders.as_number()
				_then 
					counter +<< 1
				_endif 
			_endloop
			_if counter > 1
			_then
				_leave
			_endif 			
		_endloop
		_if counter > 1
		_then
			.owner.show_alert("Terdeteksi ada nomor urut Tower yang sama/kembar (angka " + urut1.write_string + ")")
			_return 
		_endif 
		
	_when does_not_understand
		.owner.show_alert("Pastikan kolom/field folders pada object Tower sudah terisi dengan nomor urut tower")
		_return
	_endtry 


	#looping urut tower
	current_otb << _unset 
	_for i _over towers_asc.fast_elements()
	_loop	

		#_if i.folders.as_number() = 3 _then _leave _endif
		write(i.name)
		
		#scan sheath terdekat	
		ff << 500		
		(s_sheath,obj_sheath) << _self.scan_sheath(i.location,ff)
		#scan OTB terdekat
		ff << 100
		(s_t_closure,obj_t_closure) << _self.scan_OTB(obj_sheath.route.last_coord,ff)
		write("status: ", s_t_closure," nama: ",obj_t_closure.name)
		
		_if current_otb _isnt _unset
		_then
			_if obj_t_closure <> current_otb
			_then
				.owner.show_alert("Next OTB seharusnya adalah " + current_otb.name )						  
				_return 
			_endif 
		_endif 
		cs1 <<  v.world.coordinate_system 
		cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
		t << transform.new_converting_cs_to_cs(cs1,cs2)
		h << obj_t_closure.location.coord		
		w_conv << t.convert(h)
		latitud << w_conv.y
		longitud << w_conv.x
	
		koordinat << a_ff.format(latitud) + " " + a_ff.format(longitud)
	
		a_bay << obj_t_closure.mit_bays.an_element()
		
		_if a_bay _isnt _unset
		_then 
			port_jml << a_bay.all_rme_port_components()
		_else
			.owner.show_alert("Tidak terdeteksi adanya RME(Bay, Slot, Port) pada OTB: " + obj_t_closure.name )
			_return 
		_endif
		
		port_out << rope.new()
		port_in << rope.new()
		connected_cables << equality_set.new()
		panel_description << equality_set.new()
		
		_for a_port _over a_bay.all_rme_port_components().as_sorted_collection().fast_elements()
		_loop
			#write(a_port.port_text_text, " ", a_port.id)
			_if a_port.connected?
			_then
			#	write("konek: ",a_port.port_text_text, " ", a_port.id)
				_for inout _over a_port.all_connections().fast_elements()
				_loop
					_try
						#port to port
						a << inout.destination_pin.description				
						in << inout.source_pin.description						
						out << inout.destination_pin.description
				
						panel_description.add(in + "-" + out)
						
					_when does_not_understand
					
						_if inout.destination_pin.owner.source_collection.name _is :mit_slot
						_then
							#kabel ke port (fiber kabel kiri)						
							in << inout.source_pin.fiber_number
							out << inout.destination_pin.port_text_text
							port_in.add(in.write_string + "-" + out.write_string)
						
						_else
							#port ke kabel (fiber kabel kanan)
							connected_cables.add(inout.destination_pin.owner)
						
							#port ke kabel
							in << inout.source_pin.port_text_text
							out << inout.destination_pin.fiber_number
						
							port_out.add(out.write_string + "-" + in.write_string)
						_endif 
					_endtry 				
				_endloop				
			_endif 
			
		_endloop
		
		port_out << simple_vector.new_from(port_out)
	
		port_in << simple_vector.new_from(port_in)

		panel_description << simple_vector.new_from(panel_description)
		
		#check khusus last OTB, no next sheath_loc_spec
		_if i.folders = towers.size.write_string
		_then		
			obj_tree.add({i.folders, obj_t_closure.spec_id, obj_t_closure.name, koordinat, port_jml, port_in, port_out , _unset, obj_t_closure.te_object_type, 0, i.site_id, i.name, panel_description  })
				_for i _over obj_tree.fast_elements()
					_loop
						write("nama obyek di tree: ",i[3])
					_endloop
					
			_leave 		
		_endif 

		#looping cables yang terhubung dengan OTB mencari kabel yang
		# mana yang last coord = first coord jadi itu kabel lanjutannya
		current_cable << _unset 
		next_cable << _unset
		sheath_loc_spec << _unset

		_if connected_cables.size = 0
		_then
			.owner.show_alert("Fiberisasi belum dilakukan atau ada kesalahan mendefinisikan urutan tower, tower yang terkoneksi ke OTB " + obj_t_closure.name +  " seharusnya merupakan tower terakhir")
			_return 
		_endif 
		
		_for j _over connected_cables.fast_elements()
		_loop
			_if j.source_collection.name _is :mit_slot
			_then
				write("cable connected dari mit_slot: ",j)
				_continue
			_endif

			write("cable connected: ",j)
			current_cable << j
			sheath_loc_coord << j.route_coordinates().coords
		
			ketemu << 0
			counter << 0		
			_for k _over sheathlocs.fast_elements()
			 _loop
				_if k _isnt _unset
				_then 
					k_route << k.route_coordinates().coords
					counter +<< 1
				
					_if sheath_loc_coord.last = k_route.first
					_then
						#jika kabel tidak bolak balik (in/out) karena dari OTB ke ODP
						# itu ada dua kabel, bisa dimungkinkan terdeteksi last coord = first coord
						# karena penggambarannya satu dari ODP lainnya dari OTB)
						_if sheath_loc_coord.first <> k_route.last
						_then																
							sheath_loc_spec << j.spec_id
							next_cable << k
						#hapus dari list sheat loc agar tidak terdeteksi lagi selama
						# next pencarian
							sheathlocs.remove_nth(counter)			
							ketemu << 1					
						#insert to tree
						# obj_tree.add({tower.name, OTB Spec, OTB name, OTB coord, OTB
						# fiber count, OTB fiber in, fiber out, Sheath LOC spec out}		
							obj_tree.add({i.folders, obj_t_closure.spec_id, obj_t_closure.name, koordinat, port_jml, port_in, port_out, sheath_loc_spec, obj_t_closure.te_object_type, a_fc.format(j.calculated_sheath_length.value_in(:m)),i.site_id, i.name, panel_description })
						_endif				
					_endif 
				_endif 

			_endloop

		_endloop 
		
		#scan ODP/Closure
		#################
		#reassignment menjadi rope lagi		
		panel_out << rope.new()
		panel_in << rope.new()
		panel_direction << rope.new()
		port_jml << 0		
		obj_name << _unset
		
		 _for data _over splices.fast_elements()
		 _loop					 
			 _if data.location _isnt _unset 
			 _then
				 #deteksi Object ODP/Closure yang nempel di current_table
				 _if sheath_loc_coord.last = data.location.coord
				 _then
					 obj_name << data
					 
					 #in adalah current_cable								 
					 cable_in_id << _unset 
					  _for kabel _over obj_name.signal_cable_pins().fast_elements()
					 _loop
						 _if kabel.sheath_with_loc = current_cable
						 _then
							 write(obj_name.name)
							 _if kabel.all_connections().size > 0 _then cable_in_id << kabel.all_connections().an_element() _endif
							 
							 _for in _over kabel.all_connections().fast_elements()
							 _loop
								 
								 _for fiber_num _over range(in.pin1.act_low.as_number(), in.pin1.act_high.as_number())
								 _loop									
									 panel_in.add(fiber_num)
								_endloop 								 
							 _endloop				
						  _endif 
					 _endloop
					 
					 #out adalah next cable nya					 
				
					  _for kabel _over obj_name.signal_cable_pins().fast_elements()
					 _loop
						 _if kabel.sheath_with_loc = next_cable
						 _then							 
							 _for out _over kabel.all_connections().fast_elements()
							 _loop
								  #Jika kabel current id = next cable id berarti itu sambungannya
								
								 _if out = cable_in_id
								 _then
									 
									 #deteksi arah fiber (arrow direction)
									 #jika act_low = act_high berarti satu fiber,
									 #jika act_low <> act_high berarti ada beberapa fiber yang
									 # berurutan (misal: Fibres, 1-2)
									 
									 _if out.pin2.act_low.as_number() <> out.pin2.act_high.as_number()
									 _then
										 #fiber berurutan
										 _for fiber_num _over range(out.pin2.act_low.as_number(), out.pin2.act_high.as_number())
										 _loop									 																		 panel_direction.add(fiber_num.write_string + "-" + fiber_num.write_string)
										 _endloop
									 _else
										 #satu fiber
										 panel_direction.add(out.pin1.act_low.write_string + "-" + out.pin2.act_low.write_string)
									_endif 
									_for fiber_num _over range(out.pin2.act_low.as_number(), out.pin2.act_high.as_number())
									_loop									 																	 panel_out.add(fiber_num)
									_endloop
								 _endif 
							 _endloop				
						  _endif 
					 _endloop
					 
					 #Deteksi type dan jml fiber
					 splice_name << obj_name.spec_id.numbers_and_strings
					 
					 _for splice _over splice_name.fast_elements()
					 _loop
						 _if splice.class_name _isnt :integer
						 _then 
							 _if splice.trim_spaces() ="ODP" _orif splice.trim_spaces()="Join Closure" _orif splice.trim_spaces()="ODC"
